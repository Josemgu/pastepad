<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pastepad.App</RootNamespace>
    <AssemblyName>pastepad</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!--
      Lo que Windows ensena en Propiedades del archivo, y de donde sale
      Config.Version. Sin esto CompanyName decia "pastepad" —el nombre
      del ensamblado, porque nadie lo puso— y LegalCopyright estaba en
      blanco.

      Version NO se fija aqui a proposito: la pone el CI con
      -p:Version=<tag>. Escrita en el archivo se queda vieja, y ya se
      publico una release con binarios viejos por tenerla clavada en doce
      sitios (error 4 de TRASPASO.md). En una compilacion de escritorio
      sale 1.0.0, que es justo lo que debe verse fuera de una release.
    -->
    <Product>pastepad</Product>
    <AssemblyTitle>pastepad</AssemblyTitle>
    <Description>pastepad - gestor de portapapeles para Windows</Description>
    <!--
      El usuario de GitHub y no el nombre real: esto acaba dentro del
      .exe como CompanyName, que se ve en las propiedades del archivo y
      lo imprime el CI al comprobar lo publicado.
    -->
    <Company>Josemgu</Company>
    <Authors>Josemgu</Authors>
    <Copyright>Copyright (c) 2026 Josemgu. Licencia MIT.</Copyright>

    <!--
      Sin el "+<sha>" que el SDK le anade a la version informativa. Lo
      que se ensena en Propiedades y en Agregar o quitar programas es
      "4.0.0" y no "4.0.0+4bbe758f...". El commit no se pierde: una
      release sale siempre de un tag. Config.Version sigue partiendo por
      "+" por si acaso, que no cuesta nada.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Lo pide el generador de LibraryImport, que produce el codigo de
      interoperacion con punteros. No hay ni un bloque unsafe escrito a
      mano en el proyecto.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Desempaquetado y con el runtime dentro: es lo que permite instalar
      en %LOCALAPPDATA% con instalador propio y arrancar en una maquina
      que no tenga el Windows App SDK. Ver PLAN.md.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>

    <!-- Main propio: la instancia unica se decide antes de crear ventanas. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    CopyToPublishDirectory en todos: sin el, publish deja la carpeta
    Assets vacia. AppIcon.ico hace falta de verdad —Bandeja lo carga del
    disco con LoadImage, y sin el la bandeja cae al icono generico de
    Windows—, y los demas se copian para que lo publicado y lo compilado
    tengan el mismo contenido. Cuanto menos se parezcan, mas fallos que
    solo salen en lo que se distribuye.
  -->
  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pastepad.Nucleo\Pastepad.Nucleo.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    El XAML compilado (.xbf) en la carpeta de publish.

    Sin esto, `dotnet publish` deja fuera App.xbf y Panel.xbf y el
    programa publicado MUERE AL ARRANCAR con XamlParseException en el
    constructor de Panel. La compilacion normal si funciona, asi que el
    fallo solo se ve ejecutando lo que se va a distribuir — el error 5 de
    TRASPASO.md, "probar el ejecutable, no solo el codigo fuente".

    El motivo: la tarea CopyGeneratedXaml del Windows App SDK copia los
    .xbf al directorio de salida y los apunta solo en @(FileWrites). Para
    una aplicacion empaquetada los recoge despues el empaquetador de
    MSIX; desempaquetada y publicada con dotnet publish no los recoge
    nadie, porque publish arma su lista desde @(ResolvedFileToPublish).
    Aqui se anaden a esa lista.
  -->
  <Target Name="PublicarXamlCompilado"
          DependsOnTargets="ComputeProcessXamlFiles"
          BeforeTargets="ComputeResolvedFilesToPublishList">

    <ItemGroup>
      <_XamlCompilado Include="@(ProcessedXamlFiles->'%(FullPath)')" />
    </ItemGroup>

    <!-- Igual que hace el propio SDK al empaquetar: conserva las
         subcarpetas si algun dia una pagina XAML deja de estar en la
         raiz del proyecto. -->
    <AssignTargetPath Files="@(_XamlCompilado)" RootFolder="$(OutputPath)">
      <Output TaskParameter="AssignedFiles" ItemName="_XamlCompiladoConDestino" />
    </AssignTargetPath>

    <ItemGroup>
      <ResolvedFileToPublish Include="@(_XamlCompiladoConDestino)">
        <RelativePath>%(TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>

      <!--
        Y el indice de recursos de la aplicacion, que se queda fuera por
        lo mismo. Es el que resuelve ms-appx:///Microsoft.UI.Xaml/Themes/
        themeresources.xaml: sin el, con los .xbf ya en su sitio, el
        arranque sigue muriendo — solo que un paso mas adelante.
      -->
      <ResolvedFileToPublish Include="$(OutputPath)$(TargetName).pri"
                             Condition="Exists('$(OutputPath)$(TargetName).pri')">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <!--
      Que no se pueda publicar en silencio sin el indice: el fallo que
      provoca no se parece en nada a su causa.
    -->
    <Error Condition="!Exists('$(OutputPath)$(TargetName).pri')"
           Text="No existe $(OutputPath)$(TargetName).pri. Sin el indice de recursos, lo publicado arranca y muere con XamlParseException." />

    <Message Importance="high"
             Text="Se publican: @(_XamlCompiladoConDestino->'%(TargetPath)'), $(TargetName).pri" />
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Sin recorte: la guia de instancia unica avisa de fallos con el. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>