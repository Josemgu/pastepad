# Datos del usuario: nunca deben subirse
snippets.json
historial.json
config.json
imagenes/
errores.log*

# C# / .NET — salidas de compilacion, se regeneran con dotnet build
bin/
obj/
*.user
.vs/

# La carpeta de publish: 487 archivos y 200 MB, se regenera con
# dotnet publish csharp/Pastepad.App -c Release -p:Platform=x86 -r win-x86
publicado-x86/

# El instalador que produce Inno Setup: 47 MB, se regenera con
# ISCC /DVersion=<version> instalador\pastepad.iss
dist/

# El log del sondeo del atajo, que se escribe junto a su ejecutable
csharp/**/prueba-atajo.log

# Windows
Thumbs.db
desktop.ini

# Lo que dejo la version en Python. Las carpetas pueden seguir en disco
# aunque el codigo ya no este en el repo; vive en el tag
# ultima-version-python.
__pycache__/
.venv/
venv/
build/
instalador/dist/
instalador/portable/
*.spec
